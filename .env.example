# Example development configuration only.
# Never commit real production credentials.

# Application
APP_ENV=development
APP_URL=http://localhost:5173

# Authentication session
# HMAC key used by the Worker to validate server-issued session cookies.
# Generate and store the real value as a Cloudflare Worker secret.
SESSION_SIGNING_KEY=

# Google Sign-In only.
# Keep these separate from the Google Drive storage OAuth credentials introduced later.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# Email magic-link delivery.
# The reference adapter uses Resend; contributors may add alternative adapters.
RESEND_API_KEY=
AUTH_EMAIL_FROM=HRTechify Podcast Studio <signin@example.com>

# Future Google Drive storage OAuth
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Future Dropbox storage OAuth
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Credential encryption for future storage-provider refresh tokens
TOKEN_ENCRYPTION_KEY=

# Cloudflare bindings/configuration are defined in deployment configuration.
# Do not place production API tokens in this file.
