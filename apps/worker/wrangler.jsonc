{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hrtechify-public-podcast-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_URL": "https://hrtechify-public-podcast-studio.hrtechifyed.workers.dev"
  },
  "secrets": {
    "required": [
      "SESSION_SIGNING_KEY",
      "GOOGLE_AUTH_CLIENT_ID",
      "GOOGLE_AUTH_CLIENT_SECRET",
      "GOOGLE_DRIVE_CLIENT_ID",
      "GOOGLE_DRIVE_CLIENT_SECRET",
      "TOKEN_ENCRYPTION_KEY"
    ]
  },
  "images": {
    "binding": "IMAGES"
  },
  "ai": {
    "binding": "AI"
  },
  "media": {
    "binding": "MEDIA"
  },
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hrtechify-public-podcast-studio",
      "database_id": "562b9a8f-2640-4b92-8426-1575ddd2e7f6",
      "migrations_dir": "../../database/migrations"
    }
  ]
}
