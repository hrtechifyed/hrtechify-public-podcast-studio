{
  "name": "@hrtechify/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deploy": "wrangler deploy",
    "db:migrations:list": "wrangler d1 migrations list hrtechify-podcast-prod --remote",
    "db:migrate:local": "wrangler d1 migrations apply hrtechify-podcast-prod --local",
    "db:migrate:remote": "wrangler d1 migrations apply hrtechify-podcast-prod --remote"
  },
  "dependencies": {
    "@hrtechify/audio": "0.1.0",
    "@hrtechify/shared": "0.1.0",
    "@hrtechify/templates": "0.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.31.0"
  }
}
